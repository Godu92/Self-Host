## Copy to .env to pin a version. Unset shown default is used.
# OLLAMA_VERSION=latest

## Bind mount this somewhere you control instead of a Docker-managed named
## volume (e.g. an NFS-backed home dir that should carry the data with it).
# OLLAMA_DATA_DIR=./ollama_data

## CPU-only tuning, used only by compose.codeassist.yaml (ai/ollama/cpu-only.override.yaml).
## Defaults target a 16 vCPU / 32 GB VM; uncomment to change.
# OLLAMA_CPUSET=2-15
# OLLAMA_MEM_LIMIT=26g
# OLLAMA_CONTEXT_LENGTH=16384
# OLLAMA_NUM_PARALLEL=1
# OLLAMA_MAX_LOADED_MODELS=3
# OLLAMA_KEEP_ALIVE=-1
# OLLAMA_FLASH_ATTENTION=1
# OLLAMA_KV_CACHE_TYPE=q8_0
## Host CA bundle to trust inside the container (corporate TLS interception, internal CA).
## Default suits Debian/Ubuntu hosts; on RHEL use the line below.
# HOST_CA_BUNDLE=/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem
# HTTPS_PROXY=http://proxy.example:8080
