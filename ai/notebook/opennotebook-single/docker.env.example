# Single Container Open Notebook Configuration

# ==============================================
# Host Configuration
# ==============================================
HOST=localhost

# ==============================================
# Local AI Configuration (Ollama via Traefik)
# ==============================================
OLLAMA_API_BASE=http://ollama:11434
# Model settings
DEFAULT_MODEL=llama3.2:3b

# ==============================================
# Application Settings
# ==============================================
TZ=America/New_York
PYTHONUNBUFFERED=1
LOG_LEVEL=INFO
DEBUG=false
SURREAL_IGNORE_CLOSE_ERRORS=true
PYTHONWARNINGS=ignore

# CONNECTION DETAILS FOR YOUR SURREAL DB
# New format (preferred) - WebSocket URL
# SURREAL_URL="ws://surrealdb/rpc:8000"
SURREAL_USER="root"
SURREAL_PASSWORD="changeme"
SURREAL_NAMESPACE="open_notebook"
SURREAL_DATABASE="staging"

# OPEN_NOTEBOOK_PASSWORD=

# REQUIRED upstream: encrypts AI provider API keys stored in SurrealDB. Missing from this
# file until now — generate a real value with `./scripts/gen-secrets.sh` and set it in
# docker.env, don't leave it unset.
OPEN_NOTEBOOK_ENCRYPTION_KEY=changeme

# Added upstream since this was last set up: worker concurrency, hardcoded to 5 before.
# Local Ollama on modest hardware gets overloaded processing several sources at once -
# set to 1 for strictly sequential if you see that happen.
# OPEN_NOTEBOOK_WORKER_MAX_TASKS=5

# Provides: High-quality language models
# ANTHROPIC_API_KEY=

# Provides: Language models, embeddings, TTS, STT
# OPENAI_API_KEY=
