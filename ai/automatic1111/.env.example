# No secrets here — build/Dockerfile pins AUTOMATIC1111's own version (git tag), not a var.

# Extra CLI flags for the webui entrypoint (appended after --listen --port 7860).
# AUTO_CLI_ARGS=--allow-code --medvram --xformers --enable-insecure-extension-access --api

# Override where /data and /output bind-mount from. Defaults to symlinks checked into
# this directory (untracked — see repo .gitignore) that point at a sibling
# stable-diffusion-webui-docker checkout, the same one ai/comfyui shares. Set these if
# that checkout isn't present, or you want a dedicated path instead of sharing it.
# AUTO_DATA_DIR=./data
# AUTO_OUTPUT_DIR=./output
