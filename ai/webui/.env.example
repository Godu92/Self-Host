## Copy to .env, or generate with ../../scripts/gen-secrets.sh ai/webui
WEBUI_SECRET_KEY=changeme

## Copy to .env to pin a version. Unset shown default is used.
# OPEN_WEBUI_VERSION=main

## Bind mount this somewhere you control instead of a Docker-managed named
## volume (e.g. an NFS-backed home dir that should carry the data with it).
# OPEN_WEBUI_DATA_DIR=./data

## CPU-only RAG profile, used only by compose.codeassist.yaml (ai/webui/cpu-rag.override.yaml).
## These seed Open WebUI's settings on FIRST start only (empty data volume); afterwards
## change them in Admin > Settings. Uncomment to change.
# OPEN_WEBUI_MEM_LIMIT=4g
# RAG_EMBEDDING_MODEL=nomic-embed-text
# ENABLE_RAG_HYBRID_SEARCH=true
# RAG_HYBRID_BM25_WEIGHT=0.5
# RAG_TOP_K=4
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=100
# ENABLE_RETRIEVAL_QUERY_GENERATION=false
# ENABLE_TITLE_GENERATION=false
## Host CA bundle to trust inside the container. Default suits Debian/Ubuntu; on RHEL:
# HOST_CA_BUNDLE=/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem
# HTTPS_PROXY=http://proxy.example:8080
