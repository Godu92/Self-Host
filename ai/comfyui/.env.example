# No secrets here — build/Dockerfile pins ComfyUI's own version (git tag), not a var.

# Extra CLI flags for ComfyUI's entrypoint, e.g. --cpu to force CPU-only.
# COMFYUI_CLI_ARGS=

# Override where /data and /output bind-mount from. Defaults to symlinks checked into
# this directory (untracked — see repo .gitignore) that point at a sibling
# stable-diffusion-webui-docker checkout. Set these if that checkout isn't present, or
# you want a dedicated path instead of sharing it.
# COMFYUI_DATA_DIR=./data
# COMFYUI_OUTPUT_DIR=./output
