# direnv (https://direnv.net/) — run `direnv allow` after cloning.
# Loads ./.env for docker compose's own variable interpolation, then fixes up
# HOSTNAME with a real shell-evaluated value: docker compose can't evaluate
# $(hostname) itself, .env only supports literal values.
dotenv_if_exists .env
export HOSTNAME="$(hostname)"

# Set DEPLOY_STYLE=<name> in .env (host-specific, gitignored) to have every
# bare `docker compose` command in this shell automatically merge
# compose.<name>.yaml on top of the base docker-compose.yaml, instead of
# having to remember `-f docker-compose.yaml -f compose.<name>.yaml` by hand.
# Logged explicitly (rather than silently exported) since COMPOSE_FILE changes
# what `docker compose up/down/ps` actually targets.
if [[ -n "${DEPLOY_STYLE:-}" ]]; then
  style_file="compose.${DEPLOY_STYLE}.yaml"
  if [[ -f "$style_file" ]]; then
    export COMPOSE_FILE="docker-compose.yaml:${style_file}"
    log_status "COMPOSE_FILE=$COMPOSE_FILE (DEPLOY_STYLE=$DEPLOY_STYLE)"
  else
    log_error "DEPLOY_STYLE=$DEPLOY_STYLE set but $style_file doesn't exist — COMPOSE_FILE not set"
  fi
fi

source ~/py3.12/bin/activate
