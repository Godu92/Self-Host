## Copy to .env to pin a version. Unset = latest.
# TRILIUM_VERSION=latest

## By default trilium's data lives in the "tril-data" named Docker volume.
## Set this to a relative or absolute host path instead if you'd rather bind
## mount it somewhere you control directly (note: a relative path resolves
## relative to this directory, not the repo root).
# TRILIUM_DATA_DIR=./data
