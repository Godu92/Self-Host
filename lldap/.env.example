## Copy to .env, or generate with ../scripts/gen-secrets.sh lldap
## The JWT secret previously committed to this repo has been rotated —
## if you ever ran with the old one, treat it as compromised.
LLDAP_JWT_SECRET=changeme
LLDAP_LDAP_USER_PASS=changeme

## Copy to .env to pin a version. Unset shown default is used.
## "stable" is lldap's rolling stable channel (not a version number).
# LLDAP_VERSION=stable
