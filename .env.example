HOST=localhost
# HOSTNAME is set for real by .envrc (direnv), which exports the actual
# `hostname` output into your shell — docker compose can't evaluate
# $(hostname) itself, so don't rely on a literal shell substitution here.
# If you're not using direnv, set a real value manually:
# HOSTNAME=myserver.local
DOCKER_DIR=/var/run/docker.sock
# DOCKER_DIR=/run/podman/podman.sock
TRILIUM_DATA_DIR=./data # optional
