## Copy to .env to pin a version. Unset = latest.
# AUTOKUMA_VERSION=latest

## Bind mount this somewhere you control instead of a Docker-managed named
## volume (e.g. an NFS-backed home dir that should carry the data with it).
# AUTOKUMA_DATA_DIR=./data

## Uptime Kuma has no env-based initial-admin setup — log into its web UI once
## (monitoring/uptime) to create the account first, then set these to match.
## Not auto-generatable by gen-secrets.sh (must match an account you created by hand).
AUTOKUMA_KUMA_USERNAME=set-me-to-your-uptime-kuma-username
AUTOKUMA_KUMA_PASSWORD=set-me-to-your-uptime-kuma-password
