## Copy to .env, or generate with ../scripts/gen-secrets.sh n8n
## $KEY means "reuse whatever value KEY above got" — gen-secrets.sh resolves
## this; POSTGRES_PASSWORD is used by both the root postgres user and n8n's
## own DB connection (the init-data.sh that would create a separate
## non-root user is currently commented out in docker-compose.yaml, so
## POSTGRES_NON_ROOT_PASSWORD isn't actually consumed yet — kept for parity).
POSTGRES_PASSWORD=changeme
POSTGRES_NON_ROOT_PASSWORD=changeme

## Copy to .env to pin a version. Unset = latest.
# N8N_VERSION=latest
# POSTGRES_VERSION=latest

## Bind mount these somewhere you control instead of a Docker-managed named
## volume (e.g. an NFS-backed home dir that should carry the data with it).
# N8N_DB_DIR=./db-data
# N8N_DATA_DIR=./n8n-data

## Used by workflows/wikijs-to-opennotebook.json's LDAP Login node. This is NOT
## an n8n-owned secret to generate here - it must match the actual password of
## the svc-wikijs-ro service account provisioned in LLDAP (identity/lldap; see
## KNOWLEDGE.md), so keep it in sync by hand rather than re-running
## gen-secrets.sh on this file alone.
# WIKIJS_RO_PASSWORD=changeme
