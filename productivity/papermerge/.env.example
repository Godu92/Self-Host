## Copy to .env, or generate with ../scripts/gen-secrets.sh papermerge
PAPERMERGE__SECURITY__SECRET_KEY=changeme
PAPERMERGE__AUTH__PASSWORD=changeme
POSTGRES_PASSWORD=changeme

## Copy to .env to pin a version. Unset = latest.
# PAPERMERGE_VERSION=latest
# REDIS_VERSION=latest
# POSTGRES_VERSION=latest

## Bind mount these somewhere you control instead of a Docker-managed named
## volume (e.g. an NFS-backed home dir that should carry the data with it).
# PAPERMERGE_DB_DIR=./db-data
# PAPERMERGE_INDEX_DIR=./index-db
# PAPERMERGE_MEDIA_DIR=./media
