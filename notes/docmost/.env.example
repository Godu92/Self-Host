## Copy to .env, or generate with ../scripts/gen-secrets.sh docmost
APP_SECRET=changeme
POSTGRES_PASSWORD=changeme

## Copy to .env to pin a version. Unset shown default is used.
# DOCMOST_VERSION=latest
## POSTGRES_VERSION/REDIS_VERSION only set the numeric version; the -alpine
## variant is fixed. Default is a real major (not "latest") because neither
## registry publishes a generic "latest-alpine" combo tag.
# POSTGRES_VERSION=18
# REDIS_VERSION=8

## Bind mount these somewhere you control instead of a Docker-managed named
## volume (e.g. an NFS-backed home dir that should carry the data with it).
# DOCMOST_DATA_DIR=./data
# DOCMOST_DB_DIR=./db-data
# DOCMOST_REDIS_DIR=./redis-data
