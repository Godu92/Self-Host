## Copy to .env, or generate with ../scripts/gen-secrets.sh wikijs
## $KEY means "reuse whatever value KEY above got" — gen-secrets.sh resolves
## this; POSTGRES_PASSWORD and DB_PASS are the same credential (two var
## names required by the postgres image vs. the wiki.js app).
POSTGRES_PASSWORD=changeme
DB_PASS=$POSTGRES_PASSWORD

## Copy to .env to pin a version. Unset shown default is used.
## POSTGRES_VERSION only sets the numeric version; the -alpine variant is fixed.
# POSTGRES_VERSION=latest
## WIKIJS_VERSION defaults to "2" (major-only, matches upstream's own rolling
## convention) rather than "latest", since wiki.js major versions can break.
# WIKIJS_VERSION=2

## Bind mount this somewhere you control instead of a Docker-managed named
## volume (e.g. an NFS-backed home dir that should carry the data with it).
# WIKIJS_DB_DIR=./db-data
