## Copy to .env, or generate with ../scripts/gen-secrets.sh monica
## $KEY means "reuse whatever value KEY above got" — gen-secrets.sh resolves
## this; DB_PASSWORD and MYSQL_PASSWORD are the same credential (two var
## names required by the app image vs. the mariadb image).
APP_KEY=base64:changeme
DB_PASSWORD=changeme
MYSQL_PASSWORD=$DB_PASSWORD
