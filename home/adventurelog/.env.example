## Copy to .env, or generate with ../scripts/gen-secrets.sh adventurelog
POSTGRES_PASSWORD=changeme
SECRET_KEY=changeme
DJANGO_ADMIN_PASSWORD=changeme

## Copy to .env to pin a version. Unset shown default is used.
# ADVENTURELOG_FRONTEND_VERSION=latest
# ADVENTURELOG_BACKEND_VERSION=latest
## POSTGIS_VERSION only sets the numeric version; the -3.3 suffix is fixed.
# POSTGIS_VERSION=latest

## Bind mount these somewhere you control instead of a Docker-managed named
## volume (e.g. an NFS-backed home dir that should carry the data with it).
# ADVENTURELOG_DB_DIR=./db-data
# ADVENTURELOG_MEDIA_DIR=./media
