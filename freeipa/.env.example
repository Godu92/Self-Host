## Copy to .env, or generate with ../scripts/gen-secrets.sh freeipa
FREEIPA_DS_PASSWORD=changeme
FREEIPA_ADMIN_PASSWORD=changeme

## Copy to .env to pin a version. This image has no "latest" tag — tags are
## OS-variant-specific (fedora-41, rocky-9, almalinux-9, ...). Unset = the
## currently-pinned default below.
# FREEIPA_VERSION=fedora-41
