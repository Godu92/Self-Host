## Copy to .env, or generate with ../scripts/gen-secrets.sh phpipam
## $KEY means "reuse whatever value KEY above got" — gen-secrets.sh resolves
## this; IPAM_DATABASE_PASS and MYSQL_PASSWORD are the same credential (two
## var names required by the app image vs. the mariadb image).
IPAM_DATABASE_PASS=changeme
MYSQL_PASSWORD=$IPAM_DATABASE_PASS
MYSQL_ROOT_PASSWORD=changeme

## Copy to .env to pin a version. Unset = latest.
# PHPIPAM_VERSION=latest
# MARIADB_VERSION=latest

## Bind mount these somewhere you control instead of a Docker-managed named
## volume (e.g. an NFS-backed home dir that should carry the data with it).
# PHPIPAM_DB_DIR=./db-data
# PHPIPAM_LOGO_DIR=./logo
# PHPIPAM_CA_DIR=./ca-certificates
